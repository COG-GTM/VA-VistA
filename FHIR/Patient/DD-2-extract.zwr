10307:^DD(2,".105",21,1,0)="This field contains the internal entry number of the PATIENT MOVEMENT file"
10308:^DD(2,".105",21,2,0)="denoting the current admission for an inpatient.  This field is only"
10309:^DD(2,".105",21,3,0)="stored for current inpatients.  It must NOT be edited as this could affect"
10310:^DD(2,".105",21,4,0)="the integrity of many options within MAS and other DHCP packages.  When"
10311:^DD(2,".105",21,5,0)="displaying this field, the date/time of the current admission will be"
10312:^DD(2,".105",21,6,0)="displayed."
10313:^DD(2,".105","DT")=2891214
10314:^DD(2,".106",0)="LAST DMMS EPISODE NUMBER^NJ5,0^^.106;1^K:+X'=X!(X>99999)!(X<1)!(X?.E1"".""1N.N) X"
