23889:^DD("2.3129",".01",1,1,2)="K ^DPT(DA(2),.312,DA(1),9,""B"",$E(X,1,30),DA)"
23890:^DD("2.3129",".01",3)="Type a number between 1 and 99999, 0 decimal digits."
23891:^DD("2.3129",".01",21,0)="^^2^2^3130610^"
23892:^DD("2.3129",".01",21,1,0)="This field contains a sequential number generated at the time a record is"
23893:^DD("2.3129",".01",21,2,0)="stored in the subfile.  "
23894:^DD("2.3129",".01",23,0)="^^1^1^3130522^"
23895:^DD("2.3129",".01",23,1,0)="Sequential number 1..N, assigned automatically."
