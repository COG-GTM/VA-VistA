24071:^DD("2.3216",".01",1,3,"%D",0)="^^9^9^3090622^"
24072:^DD("2.3216",".01",1,3,"%D",1,0)="This cross reference is used to remember that changes were made to a"
24073:^DD("2.3216",".01",1,3,"%D",2,0)="monitored data field in the PATIENT file (#2) required for a vendor"
24074:^DD("2.3216",".01",1,3,"%D",3,0)="RAI/MDS COTS system.  Execution of this cross reference will create"
24075:^DD("2.3216",".01",1,3,"%D",4,0)="an entry in the ADT/HL7 PIVOT file (#391.71) and mark it as requiring"
24076:^DD("2.3216",".01",1,3,"%D",5,0)="transmission of an HL7 demographic A08 update message to the COTS"
24077:^DD("2.3216",".01",1,3,"%D",6,0)="interface."
24078:^DD("2.3216",".01",1,3,"%D",7,0)=" "
24079:^DD("2.3216",".01",1,3,"%D",8,0)="The local variable DGRUGA08 will be set to 1 if the cross reference is"
24080:^DD("2.3216",".01",1,3,"%D",9,0)="not to be executed as part of a re-indexing."
24081:^DD("2.3216",".01",1,3,"DT")=3090622
