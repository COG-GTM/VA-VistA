11376:^DD(2,".121",23,7,0)=""
11377:^DD(2,".121",23,8,0)="Input Parameter: DFN - internal entry number for the Patient file (#2)"
11378:^DD(2,".121",23,9,0)="   Return value: internal value of the Bad Address Indicator or <null>"
