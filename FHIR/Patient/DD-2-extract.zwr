11700:^DD(2,".131",1,991,"%D",0)="^^15^15^2990204^^^^"
11701:^DD(2,".131",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
11702:^DD(2,".131",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
11703:^DD(2,".131",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
11704:^DD(2,".131",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
11705:^DD(2,".131",1,991,"%D",5,0)=" "
11706:^DD(2,".131",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
11707:^DD(2,".131",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
11708:^DD(2,".131",1,991,"%D",8,0)="process."
11709:^DD(2,".131",1,991,"%D",9,0)=" "
11710:^DD(2,".131",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
11711:^DD(2,".131",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
11712:^DD(2,".131",1,991,"%D",12,0)="  "
11713:^DD(2,".131",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
11714:^DD(2,".131",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
11715:^DD(2,".131",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
