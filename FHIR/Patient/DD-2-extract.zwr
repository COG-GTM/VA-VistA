25354:^DD("2.398",".01","12.1")="S DIC(""S"")=""I $$TYPE^DGENA5(Y)=""""C"""""""
25355:^DD("2.398",".01",21,0)="^^10^10^3140818^^^"
25356:^DD("2.398",".01",21,1,0)="The veteran shall be determined Catastrophically Disabled if "
25357:^DD("2.398",".01",21,2,0)="he/she has one of the following conditions:"
25358:^DD("2.398",".01",21,3,0)=" - Dependent in three or more ADLs, with at least three of the"
25359:^DD("2.398",".01",21,4,0)="   dependencies being permanent, using the Katz Scale."
25360:^DD("2.398",".01",21,5,0)=" - A score of 10 or lower using the Folstein Mini-Mental State "
25361:^DD("2.398",".01",21,6,0)="   Examination."
25362:^DD("2.398",".01",21,7,0)=" - A score of 2 or lower on at least 4 of the 13 motor items "
25363:^DD("2.398",".01",21,8,0)="   using the Functional Independence Measure (FIM)"
25364:^DD("2.398",".01",21,9,0)=" - A score of 30 or lower using the Global Assessment of Functions "
25365:^DD("2.398",".01",21,10,0)="   in (GAF)"
25366:^DD("2.398",".01","DT")=3140912
25367:^DD("2.398",1,0)="SCORE^RNJ3,0XI^^0;2^K:'$$CONDINP^DGENA5($G(D0),$G(D1),X) X"
