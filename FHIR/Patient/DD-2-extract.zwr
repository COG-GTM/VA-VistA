11867:^DD(2,".132",1,991,"%D",0)="^^15^15^2990204^^^^"
11868:^DD(2,".132",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
11869:^DD(2,".132",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
11870:^DD(2,".132",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
11871:^DD(2,".132",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
11872:^DD(2,".132",1,991,"%D",5,0)=" "
11873:^DD(2,".132",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
11874:^DD(2,".132",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
11875:^DD(2,".132",1,991,"%D",8,0)="process."
11876:^DD(2,".132",1,991,"%D",9,0)=" "
11877:^DD(2,".132",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
11878:^DD(2,".132",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
11879:^DD(2,".132",1,991,"%D",12,0)="  "
11880:^DD(2,".132",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
11881:^DD(2,".132",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
11882:^DD(2,".132",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
11883:^DD(2,".132",1,991,"DT")=2970825
