23170:^DD("2.312","4.04",0)="EIV AUTO-UPDATE^S^0:NO;1:YES;^4;4^Q"
23171:^DD("2.312","4.04",3)="Set this to YES if last update to INSURANCE TYPE sub-file was done via eIV auto-update."
23172:^DD("2.312","4.04",5,1,0)="2.312^1.05^1"
23173:^DD("2.312","4.04",21,0)="^.001^4^4^3090802^^"
23174:^DD("2.312","4.04",21,1,0)="Flag that determines how the last update to INSURANCE TYPE sub-file was "
23175:^DD("2.312","4.04",21,2,0)="done. Value of ""YES"" means that data was last updated via eIV "
23176:^DD("2.312","4.04",21,3,0)="auto-update, value of ""NO"" means that data was last updated via other "
23177:^DD("2.312","4.04",21,4,0)="means."
23178:^DD("2.312","4.04",23,0)="^^2^2^3090802^"
23179:^DD("2.312","4.04",23,1,0)="This flag is set by eIV processing code (IBCNEHL* series) and cleared by "
