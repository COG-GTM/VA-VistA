21110:^DD("2.001",0,"UP")=2
21111:^DD("2.001",".01",0)="ENROLLMENT CLINIC^MP44'X^SC(^0;1^K:$P(^SC(X,0),""^"",3)'[""C"" X Q"
21112:^DD("2.001",".01",1,0)="^.1"
21113:^DD("2.001",".01",1,1,0)="2.001^B"
21114:^DD("2.001",".01",1,1,1)="S ^DPT(DA(1),""DE"",""B"",$E(X,1,30),DA)="""""
21115:^DD("2.001",".01",1,1,2)="K ^DPT(DA(1),""DE"",""B"",$E(X,1,30),DA)"
21116:^DD("2.001",".01","DT")=2851030
21117:^DD("2.001",1,0)="ENROLLMENT DATA^2.011D^^1;0"
21118:^DD("2.001",1,21,0)="^^4^4^2911214^"
21119:^DD("2.001",1,21,1,0)="This multiple contains the pertinant data relating to this patients"
21120:^DD("2.001",1,21,2,0)="enrollment in this clinic.  Data contained in this multiple includes"
21121:^DD("2.001",1,21,3,0)="the date the patient was enrolled, the date of discharge from the clinic"
21122:^DD("2.001",1,21,4,0)="and whether the patient was seen on an outpatient or ambulatory care basis."
21123:^DD("2.001",2,0)="CURRENT STATUS^S^I:INACTIVE;^0;2^Q"
21124:^DD("2.001",2,3)="If this patient is currently no longer enrolled in this clinic, enter 'I' here."
21125:^DD("2.001",2,5,1,0)="2.011^.01^1"
21126:^DD("2.001",2,5,2,0)="2.011^3^1"
21127:^DD("2.001",2,21,0)="^^2^2^2911214^"
21128:^DD("2.001",2,21,1,0)="This field will contain 'I' for inactive if this patient is no longer"
21129:^DD("2.001",2,21,2,0)="enrolled in this clinic (patient has been discharged from the clinic)."
21130:^DD("2.001","B","CURRENT STATUS",2)=""
