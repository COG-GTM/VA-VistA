22130:^DD("2.101",21,0)="WORKMEN'S COMP CLAIM FILED^S^Y:YES;N:NO;^2;2^Q"
22131:^DD("2.101",21,3)="Enter 'Y' if a workman's comp claim has been filed against this patient's employer, 'N' if it has not."
22132:^DD("2.101",21,21,0)="^^4^4^2911214^"
22133:^DD("2.101",21,21,1,0)="If the injury or condition for which this patient is being treated occurred"
22134:^DD("2.101",21,21,2,0)="while performing duties necessary for his/her job and the patient entered"
22135:^DD("2.101",21,21,3,0)="a workmen's compensation claim for this injury or condition, enter yes"
22136:^DD("2.101",21,21,4,0)="here.  Otherwise, enter no."
22137:^DD("2.101",21,"DT")=2831130
22138:^DD("2.101",22,0)="WORKMEN'S COMP CLAIM NUMBER^F^^2;3^K:$L(X)>10!($L(X)<4) X"
22139:^DD("2.101",22,3)="Enter the workman's comp claim number, 4 to 10 characters."
22140:^DD("2.101",22,21,0)="^^4^4^2911214^"
22141:^DD("2.101",22,21,1,0)="If this patient is being seen for an injury or condition s/he received"
22142:^DD("2.101",22,21,2,0)="while performing work related duties and s/he filed a claim with workmen's"
22143:^DD("2.101",22,21,3,0)="compensation, enter the claim number here.  Otherwise, leave this field"
22144:^DD("2.101",22,21,4,0)="blank."
22145:^DD("2.101",22,"DT")=2831130
22146:^DD("2.101",23,0)="NEED RELATED TO AN ACCIDENT^RS^Y:YES;N:NO;U:UNKNOWN;^2;4^Q"
22147:^DD("2.101",23,3)="Enter 'Y' if this application for care is due to an accident, 'N' if it is not, 'U' if unknown."
22148:^DD("2.101",23,21,0)="^^2^2^2911214^"
22149:^DD("2.101",23,21,1,0)="If the injury or condition for which this patient is being treated was the"
