16523:^DD(2,".361",1,2,0)="^^TRIGGER^2.0361^.01"
16524:^DD(2,".361",1,2,1)="K DIV S DIV=X,D0=DA,DIV(0)=D0 X ^DD(2,.361,1,2,89.4) S Y(102)=$S($D(^DPT(D0,""E"",D1,0)):^(0),1:"""") S X=$S('$D(^DIC(8,+$P(Y(102),U,1),0)):"""",1:$P(^(0),U,1)) S D0=I(0,0) S D1=I(1,0) S DIU=X K Y S X=DIV S X=DIV,X=X X ^DD(2,.361,1,2,1.4)"
16525:^DD(2,".361",1,2,"1.4")="S DIH=$S($D(^DPT(DIV(0),""E"",DIV(1),0)):^(0),1:""""),DIV=X I $D(^(0)) S $P(^(0),U,1)=DIV,DIH=2.0361,DIG=.01 D ^DICR:$O(^DD(DIH,DIG,1,0))>0"
16526:^DD(2,".361",1,2,2)="K DIV S DIV=X,D0=DA,DIV(0)=D0 X ^DD(2,.361,1,2,2.2) I DIV(1)>0 S DIK(0)=DA,DIK=""^DPT(DIV(0),""""E"""","",DA(1)=DIV(0),DA=DIV(1) D ^DIK S DA=DIK(0) K DIK"
16527:^DD(2,".361",1,2,"2.2")="X ^DD(2,.361,1,2,99.3) S X=$S('$D(^DIC(8,+$P(Y(102),U,1),0)):"""",1:$P(^(0),U,1)) S D0=I(0,0) S D1=I(1,0) S DIU=X K Y"
16528:^DD(2,".361",1,2,3)="This trigger stuffs the ELIGIBILITY CODE into the PATIENT'S ELIGIBILITIES multiple."
16529:^DD(2,".361",1,2,"89.2")="S I(0,0)=$S($D(D0):D0,1:""""),I(1,0)=$S($D(D1):D1,1:""""),Y(2)=$S($D(^DPT(D0,.36)):^(.36),1:"""") S X=""`"",Y(1)=X S X=$P(Y(2),U,1),X=X S Y=X,X=Y(1),X=X S X=X"
