19137:^DD(2,1901,1,991,0)="2^AVAFC1901^MUMPS"
19138:^DD(2,1901,1,991,1)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF=""1901;"" D AVAFC^VAFCDD01(DA)"
