19140:^DD(2,1901,1,991,"%D",0)="^^15^15^2990204^^"
19141:^DD(2,1901,1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
19142:^DD(2,1901,1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
19143:^DD(2,1901,1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
19144:^DD(2,1901,1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
19145:^DD(2,1901,1,991,"%D",5,0)=" "
19146:^DD(2,1901,1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
19147:^DD(2,1901,1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
19148:^DD(2,1901,1,991,"%D",8,0)="process."
19149:^DD(2,1901,1,991,"%D",9,0)=" "
19150:^DD(2,1901,1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
19151:^DD(2,1901,1,991,"%D",11,0)="variable VAFCA08 equal to 1."
19152:^DD(2,1901,1,991,"%D",12,0)="  "
19153:^DD(2,1901,1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
19154:^DD(2,1901,1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
19155:^DD(2,1901,1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
19156:^DD(2,1901,1,991,"DT")=2990204
19157:^DD(2,1901,1,992,0)="2^ADGRU1901^MUMPS"
19158:^DD(2,1901,1,992,1)="D:($T(ADGRU^DGRUDD01)'="""") ADGRU^DGRUDD01(DA)"
19159:^DD(2,1901,1,992,2)="D:($T(ADGRU^DGRUDD01)'="""") ADGRU^DGRUDD01(DA)"
19160:^DD(2,1901,1,992,"%D",0)="^^9^9^2990921^"
19161:^DD(2,1901,1,992,"%D",1,0)="This cross reference is used to remember that changes were made to a "
19162:^DD(2,1901,1,992,"%D",2,0)="monitored data field in the PATIENT File (#2) required for a vendor"
19163:^DD(2,1901,1,992,"%D",3,0)="RAI/MDS COTS system.  Execution of this cross reference will create"
19164:^DD(2,1901,1,992,"%D",4,0)="an entry in the ADT/HL7 PIVOT file (#391.71) and mark it as requiring"
19165:^DD(2,1901,1,992,"%D",5,0)="transmission of an HL7 demographic A08 update message to the COTS"
19166:^DD(2,1901,1,992,"%D",6,0)="interface."
19167:^DD(2,1901,1,992,"%D",7,0)=" "
19168:^DD(2,1901,1,992,"%D",8,0)="The local variable DGRUGA08 will be set to 1 if the cross reference is"
19169:^DD(2,1901,1,992,"%D",9,0)="not to be executed as part of a re-indexing."
