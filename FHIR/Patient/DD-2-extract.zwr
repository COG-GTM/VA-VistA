25179:^DD("2.342",".03",1,1,"FIELD")="*COMMENT - PATIENT POLICY"
25180:^DD("2.342",".03",3)="Answer must be 3-245 characters in length."
25181:^DD("2.342",".03",21,0)="^^2^2^3151229^"
25182:^DD("2.342",".03",21,1,0)="This field contains a specific comment about this Subscriber's Policy. The"
25183:^DD("2.342",".03",21,2,0)="comment must be between 3 and 245 characters in length."
25184:^DD("2.342",".03","DT")=3151229
25185:^DD("2.342",".04",0)="PERSON CONTACTED^F^^0;4^K:$L(X)>30!($L(X)<3) X"
25186:^DD("2.342",".04",3)="Enter the name of the person contacted between 3-30 characters in length.."
25187:^DD("2.342",".04",21,0)="^^4^4^3151104^"
25188:^DD("2.342",".04",21,1,0)="This is the name of the person you contacted."
25189:^DD("2.342",".04",21,2,0)="Enter a free text name.  It is recommended that"
25190:^DD("2.342",".04",21,3,0)="you use the format of Firstname MI Lastname, "
25191:^DD("2.342",".04",21,4,0)="just as they would say it to you."
25192:^DD("2.342",".04","DT")=3151116
25193:^DD("2.342",".05",0)="CONTACT PHONE #^F^^0;5^K:$L(X)>20!($L(X)<7) X"
25194:^DD("2.342",".05",3)="Enter the phone number of the person who was contacted between 7-20 characters in length.."
25195:^DD("2.342",".05",21,0)="^^5^5^3151104^"
25196:^DD("2.342",".05",21,1,0)="This is the phone number of the person you contacted."
25197:^DD("2.342",".05",21,2,0)="If you contacted an insurance company and this number"
25198:^DD("2.342",".05",21,3,0)="is not in the insurance company file, then you may want"
25199:^DD("2.342",".05",21,4,0)="to enter it into that file as well. The number entered"
25200:^DD("2.342",".05",21,5,0)="here will only be seen when looking at this contact."
25201:^DD("2.342",".05","DT")=3151116
25202:^DD("2.342",".06",0)="CALL REFERENCE NUMBER^F^^0;6^K:$L(X)>35!($L(X)<3) X"
25203:^DD("2.342",".06",3)="Enter the Call reference number which was provided by the Person Contacted between 3-35 characters in length."
25204:^DD("2.342",".06",21,0)="^^5^5^3151104^"
25205:^DD("2.342",".06",21,1,0)="If the company you called gave you a reference"
25206:^DD("2.342",".06",21,2,0)="number for the call then enter that reference"
25207:^DD("2.342",".06",21,3,0)="number here. Many companies will issue reference"
25208:^DD("2.342",".06",21,4,0)="numbers so that they can track their calls and"
25209:^DD("2.342",".06",21,5,0)="allow reference back to them by others."
25210:^DD("2.342",".06","DT")=3151116
25211:^DD("2.342",".07",0)="METHOD OF CONTACT^S^1:PHONE;2:MAIL;3:OVERNIGHT MAIL;4:PERSONAL;5:VOICE MAIL;6:OTHER;^0;7^Q"
25212:^DD("2.342",".07",3)="Select the Method of Contact: '1' for Phone, '2' for Mail, '3' for Overnight mail, '4' for Personal, '5' for Voice mail or '6' for Other."
25213:^DD("2.342",".07",21,0)="^^3^3^3151104^"
25214:^DD("2.342",".07",21,1,0)="This is the method that you used to contact the person"
25215:^DD("2.342",".07",21,2,0)="contacted in this entry.  Most contacts will be by"
25216:^DD("2.342",".07",21,3,0)="phone but many others will be my mail."
25217:^DD("2.342",".07","DT")=3151117
25218:^DD("2.342",".08",0)="AUTHORIZATION NUMBER^F^^0;8^K:$L(X)>35!($L(X)<3) X"
25219:^DD("2.342",".08",3)="Enter the Authorization Number between 3-35 characters in length."
25220:^DD("2.342",".08",21,0)="^^6^6^3151116^"
25221:^DD("2.342",".08",21,1,0)="Enter the treatment authorization number that the "
25222:^DD("2.342",".08",21,2,0)="insurance company gave you during this contact."
25223:^DD("2.342",".08",21,3,0)=" "
25224:^DD("2.342",".08",21,4,0)="The data in this field, if it exists will be connsidered"
25225:^DD("2.342",".08",21,5,0)="the Treatment Authoirzation code for this care"
25226:^DD("2.342",".08",21,6,0)="and will automatically be used by the biling module."
25227:^DD("2.342",".08","DT")=3151116
