18352:^DD(2,361,0)="PATIENT ELIGIBILITIES^2.0361IP^^E;0"
18353:^DD(2,361,3)="Choose from the available listing those eligibilities to which this patient might be entitled which are not his primary eligibility."
18354:^DD(2,361,20,0)="^.3LA^1^1"
18355:^DD(2,361,20,1,0)="ECD"
18356:^DD(2,361,21,0)="^^3^3^2911214^"
18357:^DD(2,361,21,1,0)="This multiple contains all eligibilities under which this patient can"
18358:^DD(2,361,21,2,0)="receive care.  This includes his primary eligibility and all other"
18359:^DD(2,361,21,3,0)="eligibilities he may have."
18360:^DD(2,391,0)="TYPE^RP391'a^DG(391,^TYPE;1^Q"
18361:^DD(2,391,1,0)="^.1"
18362:^DD(2,391,1,991,0)="2^AVAFC391^MUMPS"
18363:^DD(2,391,1,991,1)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF=""391;"" D AVAFC^VAFCDD01(DA)"
18364:^DD(2,391,1,991,2)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF=""391;"" D AVAFC^VAFCDD01(DA)"
18365:^DD(2,391,1,991,"%D",0)="^^15^15^2990204^^^^"
18366:^DD(2,391,1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
18367:^DD(2,391,1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
18368:^DD(2,391,1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
18369:^DD(2,391,1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
18370:^DD(2,391,1,991,"%D",5,0)=" "
18371:^DD(2,391,1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
18372:^DD(2,391,1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
18373:^DD(2,391,1,991,"%D",8,0)="process."
18374:^DD(2,391,1,991,"%D",9,0)=" "
18375:^DD(2,391,1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
18376:^DD(2,391,1,991,"%D",11,0)="variable VAFCA08 equal to 1."
18377:^DD(2,391,1,991,"%D",12,0)="  "
18378:^DD(2,391,1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
18379:^DD(2,391,1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
18380:^DD(2,391,1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
18381:^DD(2,391,1,991,"DT")=2970825
18382:^DD(2,391,3)="Choose from the available listing the PATIENT TYPE which best classifies this patient."
18383:^DD(2,391,20,0)="^.3LA^1^1"
18384:^DD(2,391,20,1,0)="ECD"
18385:^DD(2,391,21,0)="^^10^10^2990205^^^"
18386:^DD(2,391,21,1,0)="Enter the patient type for this patient.  This is selectable from the"
18387:^DD(2,391,21,2,0)="distributed entries in the TYPE OF PATIENT file.  The type selected should"
18388:^DD(2,391,21,3,0)="be the primary one selectable.  For example, if the patient is both an"
18389:^DD(2,391,21,4,0)="NSC veteran and an employee, the patient type should be NSC VETERAN, not"
18390:^DD(2,391,21,5,0)="employee."
18391:^DD(2,391,21,6,0)=" "
18392:^DD(2,391,21,7,0)="This field is used by the registration screen processor to determine which"
18393:^DD(2,391,21,8,0)="screens will be editable for this patient.  The selection of which screens"
18394:^DD(2,391,21,9,0)="can be viewed for which types of patients can be made through the 'Patient"
18395:^DD(2,391,21,10,0)="Type Update' option."
18396:^DD(2,391,23,0)="^^4^4^2990205^^"
18397:^DD(2,391,23,1,0)="The type of patient is used to determine which screens in the registration"
18398:^DD(2,391,23,2,0)="process should be allowed for entry/edit.  The 'Patient Type Update' option"
18399:^DD(2,391,23,3,0)="in MAS can be used to determine which screens are editable for each patient"
18400:^DD(2,391,23,4,0)="type."
