22019:^DD("2.101",6,3)="Enter the disposition of this application for care."
22020:^DD("2.101",6,12)="ONLY ACTIVE DISPOSITION TYPES PLEASE!"
22021:^DD("2.101",6,"12.1")="S DIC(""S"")=""I '$P(^(0),""""^"""",10)"""
22022:^DD("2.101",6,21,0)="^^4^4^2911214^"
22023:^DD("2.101",6,21,1,0)="Enter the type of disposition this patient had.  Choose from the available"
22024:^DD("2.101",6,21,2,0)="list whether the patient was scheduled for a future appointment, admitted"
22025:^DD("2.101",6,21,3,0)="to your facility or another facility, or was released from care without"
22026:^DD("2.101",6,21,4,0)="exam, for example.  Many other choices also exist."
22027:^DD("2.101",6,"DT")=2910117
22028:^DD("2.101",8,0)="REASON FOR LATE DISPOSITION^P30'^DIC(30,^0;8^Q"
22029:^DD("2.101",8,3)="Enter the reason this application for care took so long to disposition."
22030:^DD("2.101",8,21,0)="^^7^7^2911214^^"
22031:^DD("2.101",8,21,1,0)="As part of the 'MAS Parameter Entry/Edit' option, a site can determine how"
22032:^DD("2.101",8,21,2,0)="may hours must elapse before a disposition is considered to be entered"
22033:^DD("2.101",8,21,3,0)="late.  If the time between the registration (log-in) date/time and the"
22034:^DD("2.101",8,21,4,0)="disposition (log-out) date/time is found to be more than the number of"
22035:^DD("2.101",8,21,5,0)="hours specified in the MAS parameters, the user will be prompted with"
22036:^DD("2.101",8,21,6,0)="a reason for the late disposition.  This is a pointer to the DISPOSITION"
22037:^DD("2.101",8,21,7,0)="LATE REASON file."
22038:^DD("2.101",8,"DT")=2831210
22039:^DD("2.101",9,0)="WHO DISPOSITIONED^P200'^VA(200,^0;9^Q"
22040:^DD("2.101",9,3)="Enter the name of the person who dispositioned this application for care."
22041:^DD("2.101",9,21,0)="^^3^3^2911214^"
22042:^DD("2.101",9,21,1,0)="When a user dispositions a patient, the name of the user will automatically"
22043:^DD("2.101",9,21,2,0)="be entered into this field.  This field can be used for tracking purposes"
22044:^DD("2.101",9,21,3,0)="at the site and should not be edited."
22045:^DD("2.101",9,"DT")=2900924
