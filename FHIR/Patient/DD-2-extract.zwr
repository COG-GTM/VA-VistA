10091:^DD(2,".092",1,991,0)="2^AVAFC092^MUMPS"
10092:^DD(2,".092",1,991,1)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".092;"" D AVAFC^VAFCDD01(DA)"
10093:^DD(2,".092",1,991,2)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".092;"" D AVAFC^VAFCDD01(DA)"
10094:^DD(2,".092",1,991,"%D",0)="^^15^15^3021010^"
10095:^DD(2,".092",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
10096:^DD(2,".092",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
10097:^DD(2,".092",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
10098:^DD(2,".092",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
10099:^DD(2,".092",1,991,"%D",5,0)="  "
10100:^DD(2,".092",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
10101:^DD(2,".092",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
10102:^DD(2,".092",1,991,"%D",8,0)="process."
10103:^DD(2,".092",1,991,"%D",9,0)="  "
10104:^DD(2,".092",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
10105:^DD(2,".092",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
10106:^DD(2,".092",1,991,"%D",12,0)="  "
10107:^DD(2,".092",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
10108:^DD(2,".092",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
10109:^DD(2,".092",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
10110:^DD(2,".092",1,991,"DT")=3021010
10111:^DD(2,".092",1,992,0)="2^ADGRU092^MUMPS"
