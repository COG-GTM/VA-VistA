17471:^DD(2,".3858",21,0)="^^10^10^3110531^"
17472:^DD(2,".3858",21,1,0)="Class II Dental Indication is for Veterans"
17473:^DD(2,".3858",21,2,0)="having a SC non-compensable dental"
17474:^DD(2,".3858",21,3,0)="condition(s) or disability shown to have been"
17475:^DD(2,".3858",21,4,0)="in existence at the time of discharge or"
17476:^DD(2,".3858",21,5,0)="release from active duty (after September"
17477:^DD(2,".3858",21,6,0)="30, 1981).  Treatment may be authorized, as"
17478:^DD(2,".3858",21,7,0)="reasonably necessary, for a one-time"
17479:^DD(2,".3858",21,8,0)="correction of the SC non-compensable"
17480:^DD(2,".3858",21,9,0)="condition under certain conditions"
17481:^DD(2,".3858",21,10,0)="(38 CFR § 17.16)."
