10383:^DD(2,".111",1,991,"%D",0)="^.101^15^15^3171220^^^^"
10384:^DD(2,".111",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
10385:^DD(2,".111",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
10386:^DD(2,".111",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
10387:^DD(2,".111",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
10388:^DD(2,".111",1,991,"%D",5,0)=" "
10389:^DD(2,".111",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
10390:^DD(2,".111",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
10391:^DD(2,".111",1,991,"%D",8,0)="process."
10392:^DD(2,".111",1,991,"%D",9,0)=" "
10393:^DD(2,".111",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
10394:^DD(2,".111",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
10395:^DD(2,".111",1,991,"%D",12,0)="  "
10396:^DD(2,".111",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
