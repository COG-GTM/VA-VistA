9479:^DD(2,".01",1,5,"%D",0)="^^2^2^2950110^"
9480:^DD(2,".01",1,5,"%D",1,0)="This cross-reference will generate a mail message when a patient is deleted"
9481:^DD(2,".01",1,5,"%D",2,0)="or the patient's name is changed."
9482:^DD(2,".01",1,5,"DT")=2950110
9483:^DD(2,".01",1,301,0)="2^IVM01^MUMPS"
9484:^DD(2,".01",1,301,1)="S IVMX=X,X=""IVMPXFR"" X ^%ZOSF(""TEST"") D:$T DPT^IVMPXFR S X=IVMX K IVMX"
9485:^DD(2,".01",1,301,2)="S IVMX=X,X=""IVMPXFR"" X ^%ZOSF(""TEST"") D:$T DPT^IVMPXFR S X=IVMX K IVMX"
9486:^DD(2,".01",1,301,"%D",0)="^^5^5^2930513^"
9487:^DD(2,".01",1,301,"%D",1,0)="This cross-reference will check the IVM PATIENT file to see if a change"
9488:^DD(2,".01",1,301,"%D",2,0)="to this field will require transmission to the IVM Center.  If it does,"
9489:^DD(2,".01",1,301,"%D",3,0)="the IVM PATIENT file entry's TRANSMISSION STATUS will be set to 0 and"
9490:^DD(2,".01",1,301,"%D",4,0)="the nightly background job will transmit the updated information."
9491:^DD(2,".01",1,301,"DT")=2930513
9492:^DD(2,".01",1,991,0)="2^AVAFC01^MUMPS"
9493:^DD(2,".01",1,991,1)="I '$D(DFN),($T(AVAFC^VAFCDD01)'="""") S VAFCF="".01;"" D AVAFC^VAFCDD01(DA)"
9494:^DD(2,".01",1,991,2)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".01;"" D AVAFC^VAFCDD01(DA)"
9495:^DD(2,".01",1,991,"%D",0)="^^15^15^2990204^^^^"
9496:^DD(2,".01",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
9497:^DD(2,".01",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
9498:^DD(2,".01",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
9499:^DD(2,".01",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
9500:^DD(2,".01",1,991,"%D",5,0)=" "
9501:^DD(2,".01",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
9502:^DD(2,".01",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
9503:^DD(2,".01",1,991,"%D",8,0)="process."
9504:^DD(2,".01",1,991,"%D",9,0)=" "
9505:^DD(2,".01",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
9506:^DD(2,".01",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
9507:^DD(2,".01",1,991,"%D",12,0)=" "
9508:^DD(2,".01",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
9509:^DD(2,".01",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
9510:^DD(2,".01",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
9511:^DD(2,".01",1,991,"DT")=2970825
9512:^DD(2,".01",1,992,0)="2^AMPIMIS^MUMPS"
9513:^DD(2,".01",1,992,1)="I $T(SET^VAFCMIS)'=""""&('$D(VAFCNO)) D SET^VAFCMIS(DA)"
9514:^DD(2,".01",1,992,2)="I $T(KILL^VAFCMIS)'=""""&('$D(VAFCNO)) D KILL^VAFCMIS(DA)"
9515:^DD(2,".01",1,992,"%D",0)="^^4^4^2980114^^^^"
9516:^DD(2,".01",1,992,"%D",1,0)="Temporary cross reference that lets the MPI Missing ICN job know that a"
9517:^DD(2,".01",1,992,"%D",2,0)="patient was added to the Patient file, via another package other than"
9518:^DD(2,".01",1,992,"%D",3,0)="PIMS, and needs to get an ICN.  Once the ICN is assigned (local or"
9519:^DD(2,".01",1,992,"%D",4,0)="national) the cross reference is killed."
9520:^DD(2,".01",1,992,"DT")=3030603
9521:^DD(2,".01",1,993,0)="2^ADGRU01^MUMPS"
9522:^DD(2,".01",1,993,1)="D:($T(ADGRU^DGRUDD01)'="""") ADGRU^DGRUDD01(DA)"
9523:^DD(2,".01",1,993,2)="D:($T(ADGRU^DGRUDD01)'="""") ADGRU^DGRUDD01(DA)"
9524:^DD(2,".01",1,993,"%D",0)="^^9^9^3000208^"
9525:^DD(2,".01",1,993,"%D",1,0)="This cross reference is used to remember that changes were made to a"
9526:^DD(2,".01",1,993,"%D",2,0)="monitored data field in the PATIENT File (#2) required for a vendor"
9527:^DD(2,".01",1,993,"%D",3,0)="RAI/MDS COTS system.  Execution of this cross reference will create an"
9528:^DD(2,".01",1,993,"%D",4,0)="entry in the ADT/HL7 PIVOT file (#391.71) and mark it as requiring"
9529:^DD(2,".01",1,993,"%D",5,0)="transmission of an HL7 demographic A08 update message to the COTS"
9530:^DD(2,".01",1,993,"%D",6,0)="interface."
9531:^DD(2,".01",1,993,"%D",7,0)=" "
9532:^DD(2,".01",1,993,"%D",8,0)="The local variable DGRUGA08 will be set to 1 if the cross reference is not"
9533:^DD(2,".01",1,993,"%D",9,0)="to be executed as part of a re-indexing."
9534:^DD(2,".01",1,993,"DT")=3000208
9535:^DD(2,".01",3)="Enter name in 'LAST,FIRST MIDDLE SUFFIX' format, must be 3-30 characters in length."
9536:^DD(2,".01","7.5")="D INPUT^DGRPDD1"
9537:^DD(2,".01",20,0)="^.3LA^1^1"
9538:^DD(2,".01",20,1,0)="DEMOG^"
9539:^DD(2,".01",21,0)="^^4^4^2990208^^^^"
9540:^DD(2,".01",21,1,0)="Enter the patient's name in 'LAST,FIRST MIDDLE SUFFIX' format."
9541:^DD(2,".01",21,2,0)="This value must be 3-30 characters in length and may contain only uppercase"
9542:^DD(2,".01",21,3,0)="alpha characters, spaces, apostrophes, hyphens and one comma.  All other"
9543:^DD(2,".01",21,4,0)="characters and parenthetical text will be removed."
9544:^DD(2,".01","AUDIT")="y"
9545:^DD(2,".01","AX")="I 1"
9546:^DD(2,".01","DEL",100,0)="I $D(^OR(100,""ACT"",DA_"";DPT("")) D EN^DDIOL(""Patient orders must be deleted first."","""",""!?0"")"
