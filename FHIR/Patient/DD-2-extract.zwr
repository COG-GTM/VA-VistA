16344:^DD(2,".351",1,301,"%D",1,0)="This cross-reference will check the IVM PATIENT file to see if a change"
16345:^DD(2,".351",1,301,"%D",2,0)="to this field will require transmission to the IVM Center.  If it does,"
16346:^DD(2,".351",1,301,"%D",3,0)="the IVM PATIENT file entry's TRANSMISSION STATUS will be set to 0 and"
16347:^DD(2,".351",1,301,"%D",4,0)="the nightly background job will transmit the updated information."
16348:^DD(2,".351",1,301,"DT")=2930605
16349:^DD(2,".351",1,991,0)="2^AVAFC351^MUMPS"
16350:^DD(2,".351",1,991,1)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".351;"" D AVAFC^VAFCDD01(DA)"
16351:^DD(2,".351",1,991,2)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".351;"" D AVAFC^VAFCDD01(DA)"
16352:^DD(2,".351",1,991,"%D",0)="^^15^15^2990204^^"
16353:^DD(2,".351",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
16354:^DD(2,".351",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
16355:^DD(2,".351",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
16356:^DD(2,".351",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
16357:^DD(2,".351",1,991,"%D",5,0)=" "
16358:^DD(2,".351",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
16359:^DD(2,".351",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
16360:^DD(2,".351",1,991,"%D",8,0)="process."
16361:^DD(2,".351",1,991,"%D",9,0)=" "
16362:^DD(2,".351",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
16363:^DD(2,".351",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
16364:^DD(2,".351",1,991,"%D",12,0)="  "
16365:^DD(2,".351",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
16366:^DD(2,".351",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
16367:^DD(2,".351",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
16368:^DD(2,".351",1,991,"DT")=2990204
16369:^DD(2,".351",1,992,0)="2^ADGRU351^MUMPS"
16370:^DD(2,".351",1,992,1)="D:($T(ADGRU^DGRUDD01)'="""") ADGRU^DGRUDD01(DA)"
16371:^DD(2,".351",1,992,2)="D:($T(ADGRU^DGRUDD01)'="""") ADGRU^DGRUDD01(DA)"
16372:^DD(2,".351",1,992,"%D",0)="^^9^9^2990920^"
16373:^DD(2,".351",1,992,"%D",1,0)="This cross reference is used to remember that changes were made to a "
16374:^DD(2,".351",1,992,"%D",2,0)="monitored data field in the PATIENT File (#2) required for a vendor"
16375:^DD(2,".351",1,992,"%D",3,0)="RAI/MDS COTS system.  Execution of this cross reference will create"
16376:^DD(2,".351",1,992,"%D",4,0)="an entry in the ADT/HL7 PIVOT file (#391.71) and mark it as requiring"
16377:^DD(2,".351",1,992,"%D",5,0)="transmission of an HL7 demographic A08 update message to the COTS"
16378:^DD(2,".351",1,992,"%D",6,0)="interface."
16379:^DD(2,".351",1,992,"%D",7,0)=" "
16380:^DD(2,".351",1,992,"%D",8,0)="The local variable DGRUGA08 will be set to 1 if the cross reference is"
16381:^DD(2,".351",1,992,"%D",9,0)="not to be executed as part of a re-indexing."
16382:^DD(2,".351",1,992,"DT")=2990920
