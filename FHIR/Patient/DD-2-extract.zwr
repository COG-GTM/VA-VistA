22122:^DD("2.101",19,"DT")=2980114
22123:^DD("2.101",20,0)="NEED RELATED TO OCCUPATION^RS^Y:YES;N:NO;U:UNKNOWN;^2;1^Q"
22124:^DD("2.101",20,3)="Enter 'Y' if this application for care is related to the patient's occupation, 'N' if it is not, 'U' if you do not know."
22125:^DD("2.101",20,21,0)="^^3^3^2911214^"
22126:^DD("2.101",20,21,1,0)="If the need for care is related to an injury or condition acquired while"
22127:^DD("2.101",20,21,2,0)="the patient was performing work-related duties, yes should be entered here."
22128:^DD("2.101",20,21,3,0)="Otherwise, no should be entered."
