14550:^DD(2,".3216",21,4,0)="VistA except to add new episodes."
14551:^DD(2,".321701",0)="CAMP LEJEUNE^S^Y:YES;N:NO;^.3217;1^Q"
14552:^DD(2,".321701",".1")="CAMP LEJEUNE ELIGIBILITY INDICATOR"
14553:^DD(2,".321701",3)="Enter ""Y"" if there is sufficient evidence that the Veteran was housed at Camp Lejeune for a minimum of 30 days between and inclusive of August 1, 1953 and December 31, 1987.  Otherwise, enter ""N""."
14554:^DD(2,".321701",21,0)="^^6^6^3150313^"
14555:^DD(2,".321701",21,1,0)="This field should be set to Yes if the Patient is housed at Camp Lejeune,"
14556:^DD(2,".321701",21,2,0)="was a Veteran, and has 1 or more Military Service Episodes (MSEs) with a"
14557:^DD(2,".321701",21,3,0)="Character of Discharge other than Dishonorable, Other Than Honorable,"
14558:^DD(2,".321701",21,4,0)="Undesirable, Bad Conduct, or Dishonorable-VA and these MSEs were between"
14559:^DD(2,".321701",21,5,0)="August 1, 1953 and December 31, 1987, adding up to 30 days of service"
14560:^DD(2,".321701",21,6,0)="or greater."
14561:^DD(2,".321701",23,0)="^.001^2^2^3150311^^^^"
14562:^DD(2,".321701",23,1,0)="This field is a SET OF CODES field which can be Y - YES or N - NO and"
14563:^DD(2,".321701",23,2,0)="represents whether the Patient is Camp Lejeune eligible or not."
