23837:^DD("2.31211",".02",0)="DIAGNOSIS CODE^P80'^ICD9(^0;2^Q"
23838:^DD("2.31211",".02",3)="Select the diagnosis code."
23839:^DD("2.31211",".02",21,0)="^^2^2^3130522^"
23840:^DD("2.31211",".02",21,1,0)="Diagnosis Code sent by the payer in response to the insurance eligibility"
23841:^DD("2.31211",".02",21,2,0)="inquiry."
23842:^DD("2.31211",".02",23,0)="^^2^2^3130522^"
23843:^DD("2.31211",".02",23,1,0)="Source:  Health Care Diagnosis Code information in the X12 271 HI segment"
23844:^DD("2.31211",".02",23,2,0)="in these X12 loops: 2100C, 2100D.   271 HL7 message DG1.3.1"
23845:^DD("2.31211",".02","DT")=3130522
23846:^DD("2.31211",".03",0)="DIAGNOSIS CODE QUALIFIER^F^^0;3^K:$L(X)>10!($L(X)<1) X"
23847:^DD("2.31211",".03",3)="Answer must be 1-10 characters in length."
23848:^DD("2.31211",".03",21,0)="^^2^2^3130522^"
23849:^DD("2.31211",".03",21,1,0)="Diagnosis Type Code identifying a specific industry code list ICD-9 or"
23850:^DD("2.31211",".03",21,2,0)="ICD-10."
23851:^DD("2.31211",".03",23,0)="^^11^11^3130522^"
23852:^DD("2.31211",".03",23,1,0)="Source: 271 HL7 message DG1.3.3 "
23853:^DD("2.31211",".03",23,2,0)="""ABK or BK"" - represent ICD-10-CM and"
23854:^DD("2.31211",".03",23,3,0)="ICD-9-CM principal diagnosis code qualifiers. These qualifiers also"
23855:^DD("2.31211",".03",23,4,0)="represent the code as a primary code."
23856:^DD("2.31211",".03",23,5,0)=" "
23857:^DD("2.31211",".03",23,6,0)="""ABF or BF"" - also represent ICD-10-CM and ICD-9-CM diagnosis code"
23858:^DD("2.31211",".03",23,7,0)="qualifiers and these qualifiers represent the code as a secondary code."
23859:^DD("2.31211",".03",23,8,0)=" "
23860:^DD("2.31211",".03",23,9,0)="When the payer sends an ABK or an ABF, the Eligibility Communicator will"
23861:^DD("2.31211",".03",23,10,0)="map these to the HL7 code ""I10C"". When the payer sends an ABK or an ABF,"
23862:^DD("2.31211",".03",23,11,0)="the Eligibility Communicator will map these to the HL7 code ""I9C""."
23863:^DD("2.31211",".03","DT")=3130522
23864:^DD("2.31211",".04",0)="PRIMARY OR SECONDARY?^S^P:PRIMARY;S:SECONDARY;^0;4^Q"
23865:^DD("2.31211",".04",3)="Does this code represent a primary or secondary diagnosis?"
23866:^DD("2.31211",".04",21,0)="^^2^2^3130522^"
23867:^DD("2.31211",".04",21,1,0)="This field indicates whether the code in the DIAGNOSIS CODE (#.02) field"
23868:^DD("2.31211",".04",21,2,0)="is a primary or secondary diagnosis."
23869:^DD("2.31211",".04","DT")=3130522
