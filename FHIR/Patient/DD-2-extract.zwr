10000:^DD(2,".09",2)="S Y(0)=Y S:$L(Y)=11 Y=$E(Y,10,11)_$E(Y,1,9)"
10001:^DD(2,".09","2.1")="S:$L(Y)=11 Y=$E(Y,10,11)_$E(Y,1,9)"
10002:^DD(2,".09",3)="Enter 9-digit SSN or 'P' for pseudo-SSN."
10003:^DD(2,".09",10)="10/10 FORM"
10004:^DD(2,".09",11,0)="^.2LAP^^0"
10005:^DD(2,".09",11,1,0)="1^"
10006:^DD(2,".09",11,2,0)="2^"
10007:^DD(2,".09",20,0)="^.3LA^1^1"
10008:^DD(2,".09",20,1,0)="DEMOG^"
10009:^DD(2,".09",21,0)="^^14^14^3081021^"
10010:^DD(2,".09",21,1,0)="Answer with the individual's social security number.  Answer must be 9 "
10011:^DD(2,".09",21,2,0)="numbers in length. The SSN will be sent to the SSA for verification.  "
10012:^DD(2,".09",21,3,0)="This will be displayed next to the SSN.  Once an SSN has received a"
10013:^DD(2,".09",21,4,0)="status of Verified, it is locked from user updating and a ""VERIFIED"""
10014:^DD(2,".09",21,5,0)="will be displayed by the SSN field.  Only the Identity Management Data"
10015:^DD(2,".09",21,6,0)="QUality Team are able to change a beneficiary's (veteran/non veteran)"
10016:^DD(2,".09",21,7,0)="SSN.  If an Invalid per SSA status is received for the SSN, then an"
10017:^DD(2,".09",21,8,0)="""INVALID"" will appear next to the invalid SSN of the individual."
10018:^DD(2,".09",21,9,0)="Facilities should make every effort to obtain the accurate SSN from the"
10019:^DD(2,".09",21,10,0)="individual for any invalid or pseudo SSN entry."
10020:^DD(2,".09",21,11,0)=" "
10021:^DD(2,".09",21,12,0)="If a valid SSN is not known, then a ""P"" will be entered at the SSN"
10022:^DD(2,".09",21,13,0)="prompt for the system to automatically assign a Pseudo-SSN.  If a"
10023:^DD(2,".09",21,14,0)="Pseudo SSN is entered, a Reason for entering it will be required."
10024:^DD(2,".09","AUDIT")="y"
10025:^DD(2,".09","DT")=3051006
10026:^DD(2,".0901",0)="TERMINAL DIGIT OF SSN^CJ9^^ ; ^S %=$S($D(^DPT(D0,0)):$P(^(0),U,9),1:""""),X=$E(%,8,9)_$E(%,6,7)_$E(%,4,5)_$E(%,1,3)"
10027:^DD(2,".0901",".1")=""
10028:^DD(2,".0901",3)="Computed field which determines last four digits of SSN."
10029:^DD(2,".0901",9)="^"
10030:^DD(2,".0901","9.01")=""
10031:^DD(2,".0901","9.1")="S %=$S($D(^DPT(D0,0)):$P(^(0),U,9),1:""""),X=$E(%,8,9)_$E(%,6,7)_$E(%,4,5)_$E(%,1,3)"
10032:^DD(2,".0901",21,0)="^^6^6^2920130^^^"
10033:^DD(2,".0901",21,1,0)="This is a computed field which returns the terminal digit value of the"
10034:^DD(2,".0901",21,2,0)="patient's social security number.  This value is computed to be the"
10035:^DD(2,".0901",21,3,0)="last 2 digits of the social security number concatenated with the sixth"
10036:^DD(2,".0901",21,4,0)="and seventh digits of the social security number concatenated with the"
10037:^DD(2,".0901",21,5,0)="forth and fifth pieces of the social security number concatenated with the"
10038:^DD(2,".0901",21,6,0)="first 3 digits of the social security number."
10039:^DD(2,".0901","DT")=2951107
10040:^DD(2,".0905",0)="1U4N^CXJ5^^ ; ^X ^DD(2,.0905,9.2) S X=$E(Y(.0905,4),Y(.0905,5),X) S Y=X,X=Y(.0905,3),X=X_Y"
10041:^DD(2,".0905",3)="Computed field which determines first characters of last name and last four digits of SSN, i.e., 'L1234'."
10042:^DD(2,".0905",7)="S:X?1U4N DS=""I ^(0)?1""""""_$E(X,1)_"""""".E"",X=$E(X,2,5) D 7^DICM"
10043:^DD(2,".0905",9)="^"
10044:^DD(2,".0905","9.1")="$E(NAME,1)_$E(SSN,6,9)"
10045:^DD(2,".0905","9.2")="S Y(.0905,1)=$S($D(^DPT(D0,0)):^(0),1:"""") S X=$P(Y(.0905,1),U,1),Y(.0905,2)=X S X=1,X=$E(Y(.0905,2),X),Y(.0905,3)=X S X=$P(Y(.0905,1),U,9),Y(.0905,4)=X S X=6,Y(.0905,5)=X S X=9"
10046:^DD(2,".0905",21,0)="^^4^4^2911214^"
10047:^DD(2,".0905",21,1,0)="This is a computed field used to display the first character of the"
10048:^DD(2,".0905",21,2,0)="patient's last name concatenated with the last four digits of the patient's"
10049:^DD(2,".0905",21,3,0)="social security number.  This combination of characters can be used to"
10050:^DD(2,".0905",21,4,0)="look-up a patient in DHCP."
10051:^DD(2,".0906",0)="PSEUDO SSN REASON^S^R:REFUSED TO PROVIDE;S:SSN UNKNOWN/FOLLOW-UP REQUIRED;N:NO SSN ASSIGNED;^SSN;1^Q"
10052:^DD(2,".0906",1,0)="^.1^^0"
10053:^DD(2,".0906",5,1,0)="2^.09^10"
10054:^DD(2,".0906",21,0)="^^17^17^3060919^"
10055:^DD(2,".0906",21,1,0)="This field is used to document the reason the individual was assigned a "
10056:^DD(2,".0906",21,2,0)="pseudo SSN.  Based on your selection, the Pseudo SSN Report (Patient) "
10057:^DD(2,".0906",21,3,0)="option located in the Registration Menu can provide you a current "
10058:^DD(2,".0906",21,4,0)="report of the reasons entered at this prompt.  The following reasons"
10059:^DD(2,".0906",21,5,0)="are available for selection:"
10060:^DD(2,".0906",21,6,0)=" "
10061:^DD(2,".0906",21,7,0)="Refused to Provide - use this reason when the individual was asked for "
10062:^DD(2,".0906",21,8,0)="his/her SSN and refused to provide the number."
10063:^DD(2,".0906",21,9,0)=" "
10064:^DD(2,".0906",21,10,0)="SSN Unknown/Follow-up required - use this reason when the individual"
10065:^DD(2,".0906",21,11,0)="is not available to ask/answer the request for SSN.  The facility"
10066:^DD(2,".0906",21,12,0)="should initiate Follow-up activity to obtain the SSN."
10067:^DD(2,".0906",21,13,0)=" "
10068:^DD(2,".0906",21,14,0)="No SSN Assigned - use this reason when the individual has not been"
10069:^DD(2,".0906",21,15,0)="assigned an SSN. This generally applies to spouse or dependents of"
10070:^DD(2,".0906",21,16,0)="veterans who are not US citizens and infrequently, non-citizen"
10071:^DD(2,".0906",21,17,0)="beneficiaries."
10072:^DD(2,".0906","DT")=3070330
10073:^DD(2,".0907",0)="SSN VERIFICATION STATUS^S^4:VERIFIED;2:INVALID;^SSN;2^Q"
10074:^DD(2,".0907",21,0)="^^3^3^3060406^"
10075:^DD(2,".0907",21,1,0)="This field designates whether or not the SSN has been verified. This field"
10076:^DD(2,".0907",21,2,0)="will be received in the HL7 record.  It is not editable by the user.  Once"
10077:^DD(2,".0907",21,3,0)="the SSN is verified by the SSA, it is no longer editable. "
10078:^DD(2,".0907","DT")=3060406
10079:^DD(2,".091",0)="REMARKS^F^^0;10^K:$L(X)>60!($L(X)<3) X"
10080:^DD(2,".091",3)="Enter remarks concerning this patient for general display [3-60 characters]."
10081:^DD(2,".091",5,1,0)="2^.152^1"
10082:^DD(2,".091",5,2,0)="2^.351^1"
10083:^DD(2,".091",21,0)="^^4^4^2861117^^^"
10084:^DD(2,".091",21,1,0)="If so desired, you may enter a short remark about this applicant between"
10085:^DD(2,".091",21,2,0)="3-60 characters.  The remark entered should be significant and tact should"
10086:^DD(2,".091",21,3,0)="be exercised since this field is viewable to virtually all other users who"
10087:^DD(2,".091",21,4,0)="have the ability to 'call up' a patient for any purpose."
