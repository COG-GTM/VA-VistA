11158:^DD(2,".117",1,991,0)="2^AVAFC117^MUMPS"
11159:^DD(2,".117",1,991,1)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".117;"" D AVAFC^VAFCDD01(DA)"
11160:^DD(2,".117",1,991,2)="I ($T(AVAFC^VAFCDD01)'="""") S VAFCF="".117;"" D AVAFC^VAFCDD01(DA)"
11161:^DD(2,".117",1,991,"%D",0)="^^15^15^2990204^^^^"
11162:^DD(2,".117",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
11163:^DD(2,".117",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
11164:^DD(2,".117",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
11165:^DD(2,".117",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
11166:^DD(2,".117",1,991,"%D",5,0)=" "
11167:^DD(2,".117",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
11168:^DD(2,".117",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
11169:^DD(2,".117",1,991,"%D",8,0)="process."
11170:^DD(2,".117",1,991,"%D",9,0)=" "
11171:^DD(2,".117",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
11172:^DD(2,".117",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
11173:^DD(2,".117",1,991,"%D",12,0)="  "
11174:^DD(2,".117",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
11175:^DD(2,".117",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
11176:^DD(2,".117",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
