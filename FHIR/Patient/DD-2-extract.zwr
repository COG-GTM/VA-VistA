23943:^DD("2.3215",".01",0)="LOCATION OF SERVICE^*S^1:OIF;2:OEF;3:UNKNOWN OEF/OIF;^0;1^Q"
23944:^DD("2.3215",".01",1,0)="^.1"
23945:^DD("2.3215",".01",1,1,0)="2.3215^B"
23946:^DD("2.3215",".01",1,1,1)="S ^DPT(DA(1),.3215,""B"",$E(X,1,30),DA)="""""
23947:^DD("2.3215",".01",1,1,2)="K ^DPT(DA(1),.3215,""B"",$E(X,1,30),DA)"
23948:^DD("2.3215",".01",1,2,0)="2.3215^AENR321501^MUMPS"
23949:^DD("2.3215",".01",1,2,1)="D EVENT^IVMPLOG(DA(1))"
23950:^DD("2.3215",".01",1,2,2)="D EVENT^IVMPLOG(DA(1))"
23951:^DD("2.3215",".01",1,2,"%D",0)="^^2^2^3060123^"
23952:^DD("2.3215",".01",1,2,"%D",1,0)="This MUMPS cross-reference is used to notify HEC of changes to the"
23953:^DD("2.3215",".01",1,2,"%D",2,0)="LOCATION OF SERVICE field."
23954:^DD("2.3215",".01",1,2,"DT")=3060123
23955:^DD("2.3215",".01",3)="Enter OEF or OIF operation where this patient was in combat."
23956:^DD("2.3215",".01",12)="CANNOT CHANGE THE LOCATION ONCE SET"
23957:^DD("2.3215",".01","12.1")="S DIC(""S"")=""I $P($G(^DPT(DA(1),.3215,DA,0)),U),$P(^(0),U)=Y"""
23958:^DD("2.3215",".01",21,0)="^.001^2^2^3060627^^^^"
23959:^DD("2.3215",".01",21,1,0)="This is the operation in which the patient was in combat during the"
23960:^DD("2.3215",".01",21,2,0)="specified time period."
23961:^DD("2.3215",".01","DT")=3060627
23962:^DD("2.3215",".02",0)="OEF/OIF FROM DATE^DX^^0;2^S %DT=""E"" D ^%DT S X=Y I $D(X) K:'$$VALCON1^DGRPMS(DA(1),DA,X,0) X I $D(X) S DFN=DA(1) D OEIF^DGLOCK S:$D(X) DGFRDT=X"
23963:^DD("2.3215",".02",1,0)="^.1"
23964:^DD("2.3215",".02",1,1,0)="2.3215^AENR321502^MUMPS"
23965:^DD("2.3215",".02",1,1,1)="D EVENT^IVMPLOG(DA(1))"
23966:^DD("2.3215",".02",1,1,2)="D EVENT^IVMPLOG(DA(1))"
23967:^DD("2.3215",".02",1,1,"%D",0)="^^2^2^3060123^"
23968:^DD("2.3215",".02",1,1,"%D",1,0)="This MUMPS cross-reference is used to notify HEC of changes to the"
23969:^DD("2.3215",".02",1,1,"%D",2,0)="OEF/OIF FROM DATE field."
23970:^DD("2.3215",".02",1,1,"DT")=3060123
23971:^DD("2.3215",".02",3)="Enter the date the patient was deployed to the OEF/OIF area, if known.  Otherwise, enter the military pay start date for this OEF/OIF deployment."
23972:^DD("2.3215",".02",21,0)="^.001^10^10^3060508^^^^"
23973:^DD("2.3215",".02",21,1,0)="If the service indicated is OEF or UNKNOWN OEF/OIF, this date must be on"
23974:^DD("2.3215",".02",21,2,0)="or after 9/01/2001 and the end date must be after 9/11/2001.  If the"
23975:^DD("2.3215",".02",21,3,0)="service indicated is OIF, this date must be on or after 3/01/2003 and"
23976:^DD("2.3215",".02",21,4,0)="the end date must be after 3/19/2003."
23977:^DD("2.3215",".02",21,5,0)=" "
23978:^DD("2.3215",".02",21,6,0)="The meaning of this date depends on where the information was obtained"
23979:^DD("2.3215",".02",21,7,0)="from.  If the data came from the VIS, Environmental Medicine or FHIE"
23980:^DD("2.3215",".02",21,8,0)="systems, this is the start date of military pay for the assignment to"
23981:^DD("2.3215",".02",21,9,0)="the OEF/OIF operation.  If it came from any other source, it is the date"
23982:^DD("2.3215",".02",21,10,0)="the patient was actually deployed to the OEF/OIF area."
23983:^DD("2.3215",".02","DT")=3060313
23984:^DD("2.3215",".03",0)="OEF/OIF TO DATE^DX^^0;3^S %DT=""E"" D ^%DT S X=Y I $D(X) K:'$$VALCON1^DGRPMS(DA(1),DA,X,1) X I $D(X) S DFN=DA(1) D OEIF^DGLOCK"
23985:^DD("2.3215",".03",1,0)="^.1"
23986:^DD("2.3215",".03",1,1,0)="2.3215^AENR321503^MUMPS"
23987:^DD("2.3215",".03",1,1,1)="D EVENT^IVMPLOG(DA(1))"
23988:^DD("2.3215",".03",1,1,2)="D EVENT^IVMPLOG(DA(1))"
23989:^DD("2.3215",".03",1,1,"%D",0)="^^2^2^3060123^"
23990:^DD("2.3215",".03",1,1,"%D",1,0)="This MUMPS cross-reference is used to notify HEC of changes to the"
23991:^DD("2.3215",".03",1,1,"%D",2,0)="OEF/OIF TO DATE field."
23992:^DD("2.3215",".03",1,1,"DT")=3060123
23993:^DD("2.3215",".03",3)="Enter the date the patient left the OEF/OIF area if known.  Otherwise, enter the end date of military pay for this OEF/OIF deployment."
23994:^DD("2.3215",".03",4)=""
23995:^DD("2.3215",".03",21,0)="^.001^9^9^3060322^^^^"
23996:^DD("2.3215",".03",21,1,0)="If the service indicated is OEF or UNKNOWN OEF/OIF, this date must be on"
23997:^DD("2.3215",".03",21,2,0)="or after 9/11/2001. If the service indicated is OIF, this date must be on"
23998:^DD("2.3215",".03",21,3,0)="or after 3/19/2003."
23999:^DD("2.3215",".03",21,4,0)=" "
24000:^DD("2.3215",".03",21,5,0)="The meaning of this date depends on where the information was obtained"
24001:^DD("2.3215",".03",21,6,0)="from.  If the data came from the VIS, Environmental Medicine or FHIE"
24002:^DD("2.3215",".03",21,7,0)="systems, this is the military pay end date for the assignment to"
24003:^DD("2.3215",".03",21,8,0)="the OEF/OIF operation.  If it came from any other source, it is the date"
24004:^DD("2.3215",".03",21,9,0)="the patient actually left the OEF/OIF area."
24005:^DD("2.3215",".03","DT")=3090622
24006:^DD("2.3215",".04",0)="DATA LOCKED^S^0:NO;1:YES;^0;4^Q"
24007:^DD("2.3215",".04",3)="Enter YES (1) to lock the data in VistA so no changes or deletions can be made."
24008:^DD("2.3215",".04",21,0)="^.001^3^3^3051017^^"
24009:^DD("2.3215",".04",21,1,0)="This is a flag that indicates the data is 'locked' at the site and can't"
24010:^DD("2.3215",".04",21,2,0)="be changed or deleted.  This flag is set to 1 if the source of the data"
24011:^DD("2.3215",".04",21,3,0)="is the HEC system."
