18286:^DD(2,"27.03",0)="SOURCE DESIGNATION^S^V:VISTA;E:ESR;PA:PCP ACTIVE;PI:PCP INACTIVE;^ENR;3^Q"
18287:^DD(2,"27.03",3)=""
18288:^DD(2,"27.03",21,0)="^^5^5^3101202^"
18289:^DD(2,"27.03",21,1,0)="Source designation contains the value of the place the Preferred Facility "
18290:^DD(2,"27.03",21,2,0)="field (#27.02) was assigned for the patient.  Source designation is "
18291:^DD(2,"27.03",21,3,0)="automatically assigned by the system.  The VistA system can only assign "
18292:^DD(2,"27.03",21,4,0)="a Preferred Facility if the current Source Designation is VistA or "
18293:^DD(2,"27.03",21,5,0)="Primary Care Provider (PCP) Inactive."
18294:^DD(2,"27.03",23,0)="^^8^8^3101202^"
18295:^DD(2,"27.03",23,1,0)="The source designation is the place in which the preferred facility has "
18296:^DD(2,"27.03",23,2,0)="been assigned.  The users on the VistA system can only change a preferred "
18297:^DD(2,"27.03",23,3,0)="facility if the source designation is VistA or if it is Primary Care "
18298:^DD(2,"27.03",23,4,0)="Provider (PCP) Inactive.  All others options will be filed after "
18299:^DD(2,"27.03",23,5,0)="receiving a Z11 HL7 message from Enrollment System Redesign (ESR).  ESR "
18300:^DD(2,"27.03",23,6,0)="has their own rules in assigning a preferred facility on their side."
18301:^DD(2,"27.03",23,7,0)=" "
18302:^DD(2,"27.03",23,8,0)="The source designation is automatically assigned by the system."
18303:^DD(2,"27.03","DT")=3101202
