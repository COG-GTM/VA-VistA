16531:^DD(2,".361",1,2,"89.4")="X ^DD(2,.361,1,2,89.3) K DIC S Y=-1,DIC=""^DPT(D0,""""E"""","",DIC(0)=""NMFL"",DIC(""P"")=""2.0361P"",DIU(1)=$S($D(DA(1)):DA(1),1:0),DA(1)=D0 D ^DIC:D0>0 S (D,D1,DIV(1))=+Y,DA(1)=DIU(1)"
