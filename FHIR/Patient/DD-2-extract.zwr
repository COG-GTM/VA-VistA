14328:^DD(2,".32103",3)="Enter the RADIATION EXPOSURE INDICATED associated with the enrollment priority determination"
14329:^DD(2,".32103",20,0)="^.3LA^1^1"
14330:^DD(2,".32103",20,1,0)="IRD"
14331:^DD(2,".32103",21,0)="^.001^17^17^3060507^^^^"
14332:^DD(2,".32103",21,1,0)="Enter 'Y' if the veteran was exposed to ionizing radiation 1) at a"
14333:^DD(2,".32103",21,2,0)="nuclear device testing site (e.g. the Pacific Islands, NM or NV) or"
14334:^DD(2,".32103",21,3,0)="2) as a POW or while serving in Hiroshima and/or Nagasaki, Japan"
14335:^DD(2,".32103",21,4,0)="from August 6, 1945 through July 1, 1946, or 3) served at"
14336:^DD(2,".32103",21,5,0)="Department of Energy plants at Paducah, KY, Portsmouth, OH or"
14337:^DD(2,".32103",21,6,0)="the K25 area at Oak Ridge, TN for at least 250 days before"
14338:^DD(2,".32103",21,7,0)="February 1, 1992 or 4) served at Longshot, Milrow, or"
14339:^DD(2,".32103",21,8,0)="Cannikin underground nuclear tests at Amchitka Island, AK"
14340:^DD(2,".32103",21,9,0)="prior to January 1, 1974.  "
14341:^DD(2,".32103",21,10,0)=" "
14342:^DD(2,".32103",21,11,0)="Veterans exposed by method #3 or #4 are not eligible for "
14343:^DD(2,".32103",21,12,0)="copay exemption or enrollment in priority 6 based on their IR exposure."
14344:^DD(2,".32103",21,13,0)=" "
14345:^DD(2,".32103",21,14,0)="Enter 'N' if not exposed or 'U' if unknown."
14346:^DD(2,".32103",21,15,0)=" "
14347:^DD(2,".32103",21,16,0)="Once the record has been verified only HEC users "
14348:^DD(2,".32103",21,17,0)="may enter/edit this field."
