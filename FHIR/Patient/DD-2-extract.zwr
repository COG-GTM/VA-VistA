12507:^DD(2,".211",1,991,"%D",0)="^^15^15^2990204^^^"
12508:^DD(2,".211",1,991,"%D",1,0)="This cross reference is used to remember that changes were made to the"
12509:^DD(2,".211",1,991,"%D",2,0)="PATIENT file (#2) outside of the Registration process.  Execution of this"
12510:^DD(2,".211",1,991,"%D",3,0)="cross reference will create an entry in the ADT/HL7 PIVOT file (#391.71)"
12511:^DD(2,".211",1,991,"%D",4,0)="and mark it as requiring transmission of an HL7 ADT-A08 message."
12512:^DD(2,".211",1,991,"%D",5,0)=" "
12513:^DD(2,".211",1,991,"%D",6,0)="The local variable VAFCFLG will be set to 1 if the cross reference is"
12514:^DD(2,".211",1,991,"%D",7,0)="not executed because the change is being made from within the Registration"
12515:^DD(2,".211",1,991,"%D",8,0)="process."
12516:^DD(2,".211",1,991,"%D",9,0)=" "
12517:^DD(2,".211",1,991,"%D",10,0)="Execution of this cross reference can be prevented by setting the local"
12518:^DD(2,".211",1,991,"%D",11,0)="variable VAFCA08 equal to 1."
12519:^DD(2,".211",1,991,"%D",12,0)="  "
12520:^DD(2,".211",1,991,"%D",13,0)="The local variable VAFCF is used to identify the field edited."
12521:^DD(2,".211",1,991,"%D",14,0)="This data is stored in the FIELD(S) EDITED (#2.1) field in the "
12522:^DD(2,".211",1,991,"%D",15,0)="ADT/HL7 PIVOT file (#391.71)."
