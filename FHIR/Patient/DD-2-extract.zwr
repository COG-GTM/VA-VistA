21140:^DD("2.01",0,"UP")=2
21141:^DD("2.01",".01",0)="ALIAS^MFa^^0;1^K:$L(X)>30!($L(X)<3) X I $D(X) S DG20NAME=X,(X,DG20NAME)=$$FORMAT^XLFNAME7(.DG20NAME,3,30) K:'$L(X) X,DG20NAME"
21142:^DD("2.01",".01",1,0)="^.1"
21143:^DD("2.01",".01",1,1,0)="2^B^MNEMONIC"
21144:^DD("2.01",".01",1,1,1)="S:'$D(^DPT(""B"",$E(X,1,30),DA(1),DA)) ^(DA)=1"
21145:^DD("2.01",".01",1,1,2)="I $D(^DPT(""B"",$E(X,1,30),DA(1),DA)),^(DA) K ^(DA)"
21146:^DD("2.01",".01",3)="Enter name in 'LAST,FIRST MIDDLE SUFFIX' format, must be 3-30 characters in length."
21147:^DD("2.01",".01",21,0)="^^4^4^2861007^"
21148:^DD("2.01",".01",21,1,0)="Enter the alias name in 'LAST,FIRST MIDDLE SUFFIX' format."
21149:^DD("2.01",".01",21,2,0)="This value must be 3-30 characters in length and may contain only uppercase"
21150:^DD("2.01",".01",21,3,0)="alpha characters, spaces, apostrophes, hyphens and one comma.  All other"
21151:^DD("2.01",".01",21,4,0)="characters and parenthetical text will be removed."
21152:^DD("2.01",".01","AUDIT")="y"
21153:^DD("2.01",".01","DT")=3090714
21154:^DD("2.01",1,0)="ALIAS SSN^Fa^^0;2^K:$L(X)>9!($L(X)<9)!'(X?9N) X"
21155:^DD("2.01",1,3)="ANSWER MUST BE 9 CHARACTERS IN LENGTH"
21156:^DD("2.01",1,21,0)="^^3^3^2911214^"
21157:^DD("2.01",1,21,1,0)="If the patient was also known under a name other than that listed in"
21158:^DD("2.01",1,21,2,0)="the NAME field of the PATIENT file, enter the social security number"
21159:^DD("2.01",1,21,3,0)="used when the patient used this alias."
