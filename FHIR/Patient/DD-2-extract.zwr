21364:^DD("2.0361",".01",23,0)="^^9^9^2911214^^^^"
21365:^DD("2.0361",".01",23,1,0)="Unlike previous versions of the PATIENT file, in this"
21366:^DD("2.0361",".01",23,2,0)="version ALL the patient's eligibilities are stored in this"
21367:^DD("2.0361",".01",23,3,0)="multiple."
21368:^DD("2.0361",".01",23,4,0)=" "
21369:^DD("2.0361",".01",23,5,0)="When the user enters/edits that patient's PRIMARY ELIGIBILITY CODE, that"
21370:^DD("2.0361",".01",23,6,0)="code is automatically stored in the multiple as well as in"
21371:^DD("2.0361",".01",23,7,0)="the PRIMARY ELIGIBILITY CODE field."
21372:^DD("2.0361",".01",23,8,0)=" "
