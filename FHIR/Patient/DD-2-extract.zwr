17491:^DD(2,".386",".1")="PENSION INDICATOR LOCKED BY ESR"
17492:^DD(2,".386",3)="Is the Pension Indicator field locked by ESR?"
17493:^DD(2,".386",21,0)="^.001^7^7^3110608^^"
17494:^DD(2,".386",21,1,0)="This field is used to restrict the site's"
17495:^DD(2,".386",21,2,0)="ability to edit the Pension Indicator field"
17496:^DD(2,".386",21,3,0)="'RECEIVING A VA PENSION?'(#.36253) field. Once"
17497:^DD(2,".386",21,4,0)="an incoming message is received from ESR with"
17498:^DD(2,".386",21,5,0)="any Pension Data, the Pension Indicator field"
17499:^DD(2,".386",21,6,0)="becomes 'display only' and is not editable"
17500:^DD(2,".386",21,7,0)="by the VistA user."
17501:^DD(2,".386","DT")=3110505
17502:^DD(2,".3861",0)="PENSION AWARD LOCK^S^Y:YES;N:NO;^.385;11^Q"
17503:^DD(2,".3861",".1")="PENSION AWARD FIELDS LOCKED BY ESR"
17504:^DD(2,".3861",3)="Are the Pension Award fields locked by ESR?"
17505:^DD(2,".3861",21,0)="^.001^14^14^3110608^^"
17506:^DD(2,".3861",21,1,0)="This field is used to restrict the site's"
17507:^DD(2,".3861",21,2,0)="ability to edit the Pension Award fields"
17508:^DD(2,".3861",21,3,0)="'PENSION AWARD EFFECTIVE DATE'(#.3851) field"
17509:^DD(2,".3861",21,4,0)="and 'PENSION AWARD REASON'(#.3852) field."
17510:^DD(2,".3861",21,5,0)="Once an incoming message is received from ESR"
17511:^DD(2,".3861",21,6,0)="with a 'PENSION AWARD EFFECTIVE DATE'(#.3851)"
17512:^DD(2,".3861",21,7,0)="field and with a 'PENSION AWARD REASON'"
17513:^DD(2,".3861",21,8,0)="(#.3852) field of 'ORIGINAL AWARD', or with"
17514:^DD(2,".3861",21,9,0)="a 'PENSION TERMINATED REASON'(#.3854,#.3855,"
17515:^DD(2,".3861",21,10,0)="#.3856 or #.3857) field that does not have a"
17516:^DD(2,".3861",21,11,0)="NULL value, then the 'PENSION AWARD EFFECTIVE"
17517:^DD(2,".3861",21,12,0)="DATE' (#.3851) field and 'PENSION AWARD"
17518:^DD(2,".3861",21,13,0)="REASON' (#.3852) field become 'display only'"
17519:^DD(2,".3861",21,14,0)="and are not editable by the VistA user."
