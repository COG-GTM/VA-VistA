23897:^DD("2.3129",".02",0)="REFERENCE ID (GROUP)^F^^0;2^K:$L(X)>50!($L(X)<1) X"
23898:^DD("2.3129",".02",3)="Answer must be 1-50 characters in length."
23899:^DD("2.3129",".02",21,0)="^^1^1^3130522^"
23900:^DD("2.3129",".02",21,1,0)="Subscriber Supplemental Identifier."
23901:^DD("2.3129",".02",23,0)="^^2^2^3130522^"
23902:^DD("2.3129",".02",23,1,0)="X12: 271, 2100C/2100D, REF02 Reference Identification.  Source: 271 HL7"
23903:^DD("2.3129",".02",23,2,0)="message, ZRF.3"
23904:^DD("2.3129",".02","DT")=3130522
23905:^DD("2.3129",".03",0)="REF ID QUALIFIER (GROUP)^P365.028^IBE(365.028,^0;3^Q"
23906:^DD("2.3129",".03",3)="Select the reference ID qualifier."
23907:^DD("2.3129",".03",21,0)="^^2^2^3130522^"
23908:^DD("2.3129",".03",21,1,0)=" Describes the type of reference ID at the REFERENCE ID (GROUP) (#.02)"
23909:^DD("2.3129",".03",21,2,0)="field. "
23910:^DD("2.3129",".03",23,0)="^^2^2^3130522^"
23911:^DD("2.3129",".03",23,1,0)="X12: 271, 2100C/2100D, REF01 Reference Identification Qualifier.  Source:"
23912:^DD("2.3129",".03",23,2,0)="271 HL7 message, ZRF.2.1"
23913:^DD("2.3129",".03","DT")=3130522
23914:^DD("2.3129",".04",0)="DESCRIPTION^F^^0;4^K:$L(X)>80!($L(X)<1) X"
23915:^DD("2.3129",".04",3)="Answer must be 1-80 characters in length."
23916:^DD("2.3129",".04",21,0)="^^3^3^3130522^"
23917:^DD("2.3129",".04",21,1,0)="A free-form description to clarify the Reference ID in the REFERENCE ID"
23918:^DD("2.3129",".04",21,2,0)="(GROUP) (#.02) field.  It will be populated with the Plan, Group or Plan"
23919:^DD("2.3129",".04",21,3,0)="Network Name."
23920:^DD("2.3129",".04",23,0)="^^1^1^3130522^"
23921:^DD("2.3129",".04",23,1,0)="X12: 271, 2100C/2100D, REF03 DESCRIPTION.  271 HL7 message, ZRF.4"
23922:^DD("2.3129",".04","DT")=3130522
