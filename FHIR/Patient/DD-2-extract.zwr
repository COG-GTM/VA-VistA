23182:^DD("2.312","4.05",0)="PHARMACY RELATIONSHIP CODE^P9002313.19'^BPS(9002313.19,^4;5^Q"
23183:^DD("2.312","4.05",3)="Select the relationship of the patient to the cardholder."
23184:^DD("2.312","4.05",21,0)="^^10^10^3110620^"
23185:^DD("2.312","4.05",21,1,0)="This is the relationship of the patient to the cardholder."
23186:^DD("2.312","4.05",21,2,0)=" "
23187:^DD("2.312","4.05",21,3,0)="Code  Description"
23188:^DD("2.312","4.05",21,4,0)="----  -----------"
23189:^DD("2.312","4.05",21,5,0)=" 0    Not Specified"
23190:^DD("2.312","4.05",21,6,0)=" 1    Cardholder - The individual that is enrolled in and receives "
23191:^DD("2.312","4.05",21,7,0)="      benefits from a health plan"
23192:^DD("2.312","4.05",21,8,0)=" 2    Spouse - Patient is the husband/wife/partner of the cardholder"
23193:^DD("2.312","4.05",21,9,0)=" 3    Child - Patient is a child of the cardholder"
23194:^DD("2.312","4.05",21,10,0)=" 4    Other - Relationship to cardholder is not precise"
23195:^DD("2.312","4.05",23,0)="^^1^1^3110620^"
23196:^DD("2.312","4.05",23,1,0)="This field is NCPDP field 306-C6 - Patient Relationship Code"
23197:^DD("2.312","4.05","DT")=3110620
23198:^DD("2.312","4.06",0)="PHARMACY PERSON CODE^F^^4;6^K:$L(X)>3!($L(X)<1) X"
23199:^DD("2.312","4.06",3)="Answer must be 1-3 characters in length."
23200:^DD("2.312","4.06",21,0)="^^10^10^3110621^"
23201:^DD("2.312","4.06",21,1,0)="This is the code that is assigned by the payer to identify the patient.  "
23202:^DD("2.312","4.06",21,2,0)="The payer may use a unique person code to identify each specific person on"
23203:^DD("2.312","4.06",21,3,0)="the pharmacy insurance policy. This code may also describe the patient's"
23204:^DD("2.312","4.06",21,4,0)="relationship to the cardholder."
23205:^DD("2.312","4.06",21,5,0)=" "
23206:^DD("2.312","4.06",21,6,0)="Enrollment Standard Examples:"
23207:^DD("2.312","4.06",21,7,0)=" "
23208:^DD("2.312","4.06",21,8,0)="  001 = Cardholder"
23209:^DD("2.312","4.06",21,9,0)="  002 = Spouse"
23210:^DD("2.312","4.06",21,10,0)="  003 - 999 = Dependents and Others (including second spouses, etc.)"
23211:^DD("2.312","4.06",23,0)="^^1^1^3110621^"
23212:^DD("2.312","4.06",23,1,0)="This is NCPDP field 303-C3 - Person Code"
