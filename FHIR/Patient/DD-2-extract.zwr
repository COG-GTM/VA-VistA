25745:^DD("2.98",18,0)="APPT. CANCELLED^P44'^SC(^0;17^Q"
25746:^DD("2.98",18,21,0)="^^4^4^2880623^^"
25747:^DD("2.98",18,21,1,0)="Field is set when user cancels another appointment set at the same time"
25748:^DD("2.98",18,21,2,0)="in another clinic for the same patient. This field reflects the clinic"
25749:^DD("2.98",18,21,3,0)="in which the patient had a scheduled appointment which was cancelled to"
25750:^DD("2.98",18,21,4,0)="set this appointment."
25751:^DD("2.98",18,"DT")=2880401
25752:^DD("2.98",19,0)="DATA ENTRY CLERK^P200'^VA(200,^0;18^Q"
25753:^DD("2.98",19,21,0)="^^3^3^2911214^^"
25754:^DD("2.98",19,21,1,0)="This field contains the name of the user that entered the appointment"
25755:^DD("2.98",19,21,2,0)="into the scheduling system.  This field is created automatically by the"
25756:^DD("2.98",19,21,3,0)="scheduling module and should not be edited."
25757:^DD("2.98",19,"DT")=2901017
25758:^DD("2.98",20,0)="DATE APPT. MADE^D^^0;19^S %DT=""EX"" D ^%DT S X=Y K:Y<1 X"
25759:^DD("2.98",20,1,0)="^.1"
25760:^DD("2.98",20,1,1,0)="2^ASADM^MUMPS"
25761:^DD("2.98",20,1,1,1)="S ^DPT(""ASADM"",$E(X,1,30),DA(1),DA)="""""
25762:^DD("2.98",20,1,1,2)="K ^DPT(""ASADM"",$E(X,1,30),DA(1),DA)"
25763:^DD("2.98",20,1,1,"DT")=2991105
25764:^DD("2.98",20,21,0)="^^3^3^2911214^"
25765:^DD("2.98",20,21,1,0)="This field contains the date the appointment was entered into sheduling"
25766:^DD("2.98",20,21,2,0)="system.  This field is creatd automatically by the scheduling module and"
25767:^DD("2.98",20,21,3,0)="should not be edited."
25768:^DD("2.98",20,"DT")=2991105
25769:^DD("2.98",21,0)="OUTPATIENT ENCOUNTER^P409.68'^SCE(^0;20^Q"
25770:^DD("2.98",21,"DT")=2930209
25771:^DD("2.98",22,0)="ENCOUNTER FORMS PRINTED^S^0:NO;1:YES;^0;21^Q"
25772:^DD("2.98",22,3)="Enter YES if the required encounter forms and reports have been printed for the appointment."
25773:^DD("2.98",22,21,0)="^^3^3^2930924^"
25774:^DD("2.98",22,21,1,0)="Used by the Print Manager to indicate that it has printed"
25775:^DD("2.98",22,21,2,0)="the encounter forms and other reports required by the division and"
25776:^DD("2.98",22,21,3,0)="clinic for the appointment."
25777:^DD("2.98",22,23,0)="^^2^2^2930924^^^"
25778:^DD("2.98",22,23,1,0)="Used by IB to indicate whether or not encounter forms have been printed"
25779:^DD("2.98",22,23,2,0)="for the patient."
25780:^DD("2.98",22,"DT")=2930922
25781:^DD("2.98",23,0)="ENCOUNTER FORMS AS ADD-ONS^S^0:NO;1:YES;^0;22^Q"
25782:^DD("2.98",23,3)="Enter YES if the required encounter forms and reports have been printed for the appointment as an add-on."
25783:^DD("2.98",23,21,0)="^^3^3^2930924^"
25784:^DD("2.98",23,21,1,0)="Used by the Print Manager to indicate that it has printed"
25785:^DD("2.98",23,21,2,0)="the encounter forms and other reports required by the division and"
25786:^DD("2.98",23,21,3,0)="clinic for the appointment and they were printed as an add-on."
25787:^DD("2.98",23,23,0)="^^2^2^2930924^^^"
25788:^DD("2.98",23,23,1,0)="Used by IB to indicate that encounter forms & reports were printed as an"
25789:^DD("2.98",23,23,2,0)="add-on."
25790:^DD("2.98",23,"DT")=2930922
25791:^DD("2.98","23.1",0)="ENCOUNTER CONVERSION STATUS^S^0:NOT CONVERTED;1:CONVERTED;^0;23^Q"
25792:^DD("2.98","23.1",3)=""
25793:^DD("2.98","23.1",21,0)="^^5^5^2991228^"
25794:^DD("2.98","23.1",21,1,0)="This field indicates whether or not this appointment was converted  "
25795:^DD("2.98","23.1",21,2,0)="during the ACRP Database Conversion (SD*5.3*211)."
25796:^DD("2.98","23.1",21,3,0)=" "
25797:^DD("2.98","23.1",21,4,0)="The field is set to '1' after the appointment has been converted"
25798:^DD("2.98","23.1",21,5,0)="by the conversion software.                                         "
25799:^DD("2.98","23.1","DT")=2980114
25800:^DD("2.98",24,0)="APPOINTMENT TYPE SUB-CATEGORY^P35.2'^DG(35.2,^0;24^Q"
25801:^DD("2.98",24,3)="Please enter the sub-category associated with this appointment."
25802:^DD("2.98",24,21,0)="^^1^1^2970305^"
25803:^DD("2.98",24,21,1,0)="This field contains the sub-category associated with this appoitment."
25804:^DD("2.98",24,"DT")=2970305
25805:^DD("2.98",25,0)="SCHEDULING REQUEST TYPE^RS^N:'NEXT AVAILABLE' APPT.;C:OTHER THAN 'NEXT AVA.' (CLINICIAN REQ.);P:OTHER THAN 'NEXT AVA.' (PATIENT REQ.);W:WALKIN APPT.;M:MULTIPLE APPT. BOOKING;A:AUTO REBOOK;O:OTHER THAN 'NEXT AVA.' APPT.;^0;25^Q"
25806:^DD("2.98",25,3)="Enter the type of request that initiated the scheduling of this appointment."
25807:^DD("2.98",25,"DT")=3001107
25808:^DD("2.98",26,0)="NEXT AVA. APPT. INDICATOR^RS^0:NOT INDICATED TO BE A 'NEXT AVA.' APPT.;1:'NEXT AVA.' APPT. INDICATED BY USER;2:'NEXT AVA.' APPT. INDICATED BY CALCULATION;3:'NEXT AVA.' APPT. INDICATED BY USER & CALCULATION;^0;26^Q"
25809:^DD("2.98",26,3)="Specify if this appointment was indicated by the user or by calculation to be a 'next available' appointment scheduling request."
25810:^DD("2.98",26,"DT")=2991105
25811:^DD("2.98",27,0)="DESIRED DATE OF APPOINTMENT^D^^1;1^S %DT=""EX"" D ^%DT S X=Y K:Y<1 X"
25812:^DD("2.98",27,".1")="CID/PREFERRED DATE"
25813:^DD("2.98",27,1,0)="^.1^^0"
25814:^DD("2.98",27,3)="Enter the clinician or patient desired date for this appointment."
25815:^DD("2.98",27,21,0)="^.001^5^5^3151112^^^"
25816:^DD("2.98",27,21,1,0)="This is the desired date for the appointment. The field title contains"
25817:^DD("2.98",27,21,2,0)="'CID/PREFERRED DATE', where 'CID' stands for Clinically Indicated Date."
25818:^DD("2.98",27,21,3,0)="This is an alternate name for the field name used for reports and to"
25819:^DD("2.98",27,21,4,0)="present to users when adding and displaying appointment information in the"
25820:^DD("2.98",27,21,5,0)="Scheduling package."
25821:^DD("2.98",27,"DT")=3151112
25822:^DD("2.98",28,0)="FOLLOW-UP VISIT^S^1:YES;0:NO;^1;2^Q"
25823:^DD("2.98",28,3)="Indicate if this is a follow-up visit for conditions already being treated by this clinician or clinic."
25824:^DD("2.98",28,"DT")=3001107
25825:^DD("2.98",29,0)="SCHEDULING APPLICATION^FJ30^^1;3^K:$L(X)>30!($L(X)<1) X"
25826:^DD("2.98",29,3)="Answer must be 1-30 characters in length."
25827:^DD("2.98",29,21,0)="^^1^1^3181018^"
25828:^DD("2.98",29,21,1,0)="Name of the application that was used to schedule this appointment."
25829:^DD("2.98",29,"DT")=3181018
25830:^DD("2.98",30,0)="SCHEDULER NAME^FJ35^^1;4^K:$L(X)>35!($L(X)<3) X"
25831:^DD("2.98",30,3)="Answer must be 3-35 characters in length."
25832:^DD("2.98",30,21,0)="^^3^3^3181018^"
25833:^DD("2.98",30,21,1,0)="The name of the person who scheduled this appointment. This is mainly for "
25834:^DD("2.98",30,21,2,0)="CCRA integration, as the CCRA user may not be an active user on the local "
25835:^DD("2.98",30,21,3,0)="VistA system."
25836:^DD("2.98",30,"DT")=3181018
25837:^DD("2.98",100,0)="CURRENT STATUS^CJ35^^ ; ^D CURRENT^SDAMU"
25838:^DD("2.98",100,9)="^"
25839:^DD("2.98",100,"9.01")=""
25840:^DD("2.98",100,"9.1")="D CURRENT^SDAMU"
25841:^DD("2.98",100,21,0)="^^12^12^2920715^^^"
25842:^DD("2.98",100,21,1,0)="This computed field determines the current status for the"
25843:^DD("2.98",100,21,2,0)="appointment. The difference between this field and the STATUS "
25844:^DD("2.98",100,21,3,0)="field is that appointments with a blank STATUS are further defined "
25845:^DD("2.98",100,21,4,0)="in this CURRENT STATUS field. "
25846:^DD("2.98",100,21,5,0)=" "
25847:^DD("2.98",100,21,6,0)="Appointments with a blank STATUS may have a CURRENT STATUS of any"
25848:^DD("2.98",100,21,7,0)="one of the following:"
25849:^DD("2.98",100,21,8,0)="          o FUTURE"
25850:^DD("2.98",100,21,9,0)="          o NO ACTION TAKEN"
25851:^DD("2.98",100,21,10,0)="          o CHECKED IN"
25852:^DD("2.98",100,21,11,0)="          o CHECKED OUT"
25853:^DD("2.98",100,21,12,0)="          o NON-COUNT"
25854:^DD("2.98",100,"DT")=2920212
