18887:^DD(2,"1010.157",21,5,0)=" "
18888:^DD(2,"1010.157",21,6,0)="    DID YOU SERVE IN COMBAT AFTER 11/11/1998?"
18889:^DD(2,"1010.157",21,7,0)=" "
18890:^DD(2,"1010.157",21,8,0)="This field may contain any of the following:"
18891:^DD(2,"1010.157",21,9,0)=" "
18892:^DD(2,"1010.157",21,10,0)="    0 for ""NO"""
18893:^DD(2,"1010.157",21,11,0)="    1 for ""YES"""
18894:^DD(2,"1010.157",21,12,0)="    null (i.e., not answered)"
18895:^DD(2,"1010.157",21,13,0)=" "
