18269:^DD(2,"27.02",21,7,0)="      M&ROC        (Medical and Regional Office Center)"
18270:^DD(2,"27.02",21,8,0)="      MOC          (Mobile Outpatient Clinic)"
18271:^DD(2,"27.02",21,9,0)="      MORC         (Mobile Outreach Clinic)"
18272:^DD(2,"27.02",21,10,0)="      NETWORK      (VA Healthcare Network Upstate NY)"
18273:^DD(2,"27.02",21,11,0)="      NHC          (Nursing Home Care)"
18274:^DD(2,"27.02",21,12,0)="      OC           (Outpatient Clinic - Independent)"
18275:^DD(2,"27.02",21,13,0)="      OCMC         (Outpatient Clinic - Subordinate)"
18276:^DD(2,"27.02",21,14,0)="      OCS          (Outpatient Clinic Substation)"
18277:^DD(2,"27.02",21,15,0)="      OPC          (Out Patient Clinic)"
18278:^DD(2,"27.02",21,16,0)="      ORC          (Outreach Clinic)"
18279:^DD(2,"27.02",21,17,0)="      RO-OC        (Regional Office - Outpatient Clinic)"
18280:^DD(2,"27.02",21,18,0)="      SATELLITE    (Satellite Outpatient Clinic)"
18281:^DD(2,"27.02",21,19,0)="      SOC          (Satellite Outpatient Clinic)"
18282:^DD(2,"27.02",21,20,0)="      VAMC         (VA Medical Center)"
18283:^DD(2,"27.02",21,21,0)="      VANPH        (Neural Psychiatric Hospital)"
18284:^DD(2,"27.02",21,22,0)="      VA ROSEBERG  (VA Roseburg Health Care System)"
