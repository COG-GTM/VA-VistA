14545:^DD(2,".3216",0)="MILITARY SERVICE EPISODE^2.3216D^^.3216;0"
14546:^DD(2,".3216",21,0)="^.001^4^4^3090226^^^^"
14547:^DD(2,".3216",21,1,0)="This contains the definitive military service episode history for the "
14548:^DD(2,".3216",21,2,0)="patient and is updated from the Health Eligibility Center (HEC) system.  "
