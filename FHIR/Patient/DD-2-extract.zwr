17526:^DD(2,".39",1,1,"%D",0)="^.101^2^2^3110301^^"
17527:^DD(2,".39",1,1,"%D",1,0)="This cross-reference is used to auto-update the patients"
17528:^DD(2,".39",1,1,"%D",2,0)="PATIENT ENROLLMENT (#27.11) record."
17529:^DD(2,".39",1,1,"DT")=2990618
17530:^DD(2,".39",1,2,0)="2^AVCDMT^MUMPS"
17531:^DD(2,".39",1,2,1)="N DFN,DGMT,DGNOCOPF,DGREQF,DGWRT,IVMZ10F S DFN=DA D EN^DGMTR"
17532:^DD(2,".39",1,2,2)="N DFN,DGMT,DGNOCOPF,DGREQF,DGWRT,IVMZ10F S DFN=DA D EN^DGMTR"
17533:^DD(2,".39",1,2,"%D",0)="^^20^20^3110302^"
17534:^DD(2,".39",1,2,"%D",1,0)="This cross-reference calls the Means Test software."
17535:^DD(2,".39",1,2,"%D",2,0)="If answered 'YES', then a Means Test is not"
17536:^DD(2,".39",1,2,"%D",3,0)="required and the Rx Copay is exempt."
17537:^DD(2,".39",1,2,"%D",4,0)="Executing this cross-reference will result in the"
17538:^DD(2,".39",1,2,"%D",5,0)="following file and field changes:"
17539:^DD(2,".39",1,2,"%D",6,0)=" "
17540:^DD(2,".39",1,2,"%D",7,0)="ANNUAL MEANS TEST FILE (#408.31)"
17541:^DD(2,".39",1,2,"%D",8,0)="  Field: STATUS (#.03)"
17542:^DD(2,".39",1,2,"%D",9,0)="  When a veteran is determined to be Catastrophically Disabled, the STATUS"
17543:^DD(2,".39",1,2,"%D",10,0)="field is set to NO LONGER APPLICABLE."
17544:^DD(2,".39",1,2,"%D",11,0)="  When a Catastrophically Disabled veteran is no longer determined to be"
17545:^DD(2,".39",1,2,"%D",12,0)="Catastrophically Disabled, then the STATUS field is set to one of the"
17546:^DD(2,".39",1,2,"%D",13,0)="sixteen possible Means Test statuses."
17547:^DD(2,".39",1,2,"%D",14,0)=" "
17548:^DD(2,".39",1,2,"%D",15,0)="BILLING EXEMPTIONS FILE (#354.1)"
17549:^DD(2,".39",1,2,"%D",16,0)="  Field: STATUS (#.04)"
17550:^DD(2,".39",1,2,"%D",17,0)="  When a veteran is determined to be Catastrophically Disabled, the STATUS"
17551:^DD(2,".39",1,2,"%D",18,0)="field is set to EXEMPT."
17552:^DD(2,".39",1,2,"%D",19,0)="  When a Catastrophically Disabled veteran is no longer determined to be"
17553:^DD(2,".39",1,2,"%D",20,0)="Catastrophically Disabled, then the STATUS field is set to NON-EXEMPT."
17554:^DD(2,".39",1,2,"DT")=3110302
17555:^DD(2,".39",3)="Enter a Yes or No for whether the patient is Catastrophically Disabled."
17556:^DD(2,".39",21,0)="^.001^2^2^3140912^^^^"
17557:^DD(2,".39",21,1,0)="This field states whether or not the patient is a veteran who has been"
17558:^DD(2,".39",21,2,0)="determined to meet the criteria for CATASTROPHICALLY DISABLED."
17559:^DD(2,".39","DT")=3110302
