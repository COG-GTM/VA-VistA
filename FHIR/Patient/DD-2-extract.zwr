18263:^DD(2,"27.02",21,1,0)="The facility that the patient chooses to designate as his preferred"
18264:^DD(2,"27.02",21,2,0)="location for care."
18265:^DD(2,"27.02",21,3,0)="The facility must have one of the following facility types:"
18266:^DD(2,"27.02",21,4,0)="      CBOC         (Community Based Outpatient Clinic)"
18267:^DD(2,"27.02",21,5,0)="      HCS          (Health Care System)"
